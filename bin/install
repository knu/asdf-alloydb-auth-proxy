#!/usr/bin/env bash

set -euo pipefail

main() {
  [ "${ASDF_INSTALL_TYPE:-}" = version ] || die "unsupported ASDF_INSTALL_TYPE: ${ASDF_INSTALL_TYPE:-}"
  [ -n "${ASDF_DOWNLOAD_PATH:-}" ] || die "ASDF_DOWNLOAD_PATH is required"
  [ -n "${ASDF_INSTALL_PATH:-}" ] || die "ASDF_INSTALL_PATH is required"

  mkdir -p "$ASDF_INSTALL_PATH/bin"
  cp "$ASDF_DOWNLOAD_PATH/alloydb-auth-proxy" "$ASDF_INSTALL_PATH/bin/alloydb-auth-proxy"
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

main
